@page
@model IndexModel

@{
    ViewData["Title"] = "IT Help Desk Ticket Tracker";
}

<h1>IT Help Desk Ticket Tracker</h1>

<h2>Submit Support Ticket</h2>

<form method="post">
    <label>Employee Name:</label>
    <input type="text" name="EmployeeName" />

    <br />

    <label>Problem Description:</label>
    <input type="text" name="Description" />

    <br />

    <button type="submit">Submit Ticket</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}

<h2>Ticket Summary</h2>

<p>Open Tickets: @Model.OpenTickets</p>
<p>In Progress Tickets: @Model.InProgressTickets</p>
<p>Closed Tickets: @Model.ClosedTickets</p>
<p>Total Tickets: @Model.TotalTickets</p>

<h2>View My Tickets</h2>

<form method="get">
    <label>Employee Name:</label>
    <input type="text" name="searchEmployeeName"
           value="@Model.SearchEmployeeName" />

    <button type="submit">Search</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.SearchEmployeeName))
{
    <h3>My Tickets</h3>

    <table border="1">
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Employee Name</th>
                <th>Description</th>
                <th>Submission Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.MyTickets)
            {
                <tr>
                    <td>@ticket.TicketID</td>
                    <td>@ticket.EmployeeName</td>
                    <td>@ticket.Description</td>
                    <td>@ticket.SubmissionDate</td>
                    <td>@ticket.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Support Tickets</h2>

<table border="1">
    <thead>
        <tr>
            <th>Ticket ID</th>
            <th>Employee Name</th>
            <th>Description</th>
            <th>Submission Date</th>
            <th>Status</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model.Tickets)
        {
            <tr>
                <td>@ticket.TicketID</td>
                <td>@ticket.EmployeeName</td>
                <td>@ticket.Description</td>
                <td>@ticket.SubmissionDate</td>
                <td>
                    <form method="post" asp-page-handler="UpdateStatus">
                        <input type="hidden" name="ticketId" value="@ticket.TicketID" />

                        <select name="status">
                            <option value="Open" selected="@(ticket.Status == "Open")">Open</option>
                            <option value="In Progress" selected="@(ticket.Status == "In Progress")">In Progress</option>
                            <option value="Closed" selected="@(ticket.Status == "Closed")">Closed</option>
                        </select>

                        <button type="submit">Update</button>
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="EditTicket">
                        <input type="hidden" name="ticketId" value="@ticket.TicketID" />

                        <input type="text" name="employeeName" value="@ticket.EmployeeName" />
                        <input type="text" name="description" value="@ticket.Description" />

                        <button type="submit">Save Edit</button>
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="DeleteTicket">
                        <input type="hidden" name="ticketId" value="@ticket.TicketID" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
